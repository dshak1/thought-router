#!/usr/bin/env python3
"""Jiga: the opinionated friend. Replies to a phone thought on Telegram, in character.

  thought-friend ID_PREFIX       reply to one text thought from the inbox
  thought-friend --text "..."    reply to given text
  add --dry-run to print the reply instead of sending it

Persona lives in ~/.config/thought-router/jiga.md (private, not in git). Reply is generated by a headless
`claude -p` call with no tools and no settings, and sent only to Diar's own Telegram chat through tg-send.
Records which thoughts already got a reply in ~/.local/share/thought-router/friend.json.
"""
import argparse, json, os, subprocess, sys

BASE = os.path.expanduser(os.environ.get("THOUGHT_ROUTER_HOME", "~/.local/share/thought-router"))
PERSONA = os.path.expanduser("~/.config/thought-router/jiga.md")
STATE = os.path.join(BASE, "friend.json")


def load_state():
    try:
        return json.load(open(STATE))
    except Exception:
        return {}


def reply(text, model):
    persona = open(PERSONA, encoding="utf-8").read()
    prompt = persona + "\n\nDiar's thought, between the markers. Reply as Jiga.\n<<<THOUGHT\n" + text[:2000] + "\nTHOUGHT>>>\n"
    r = subprocess.run(["claude", "-p", prompt, "--model", model, "--tools", "", "--setting-sources", "", "--no-session-persistence"],
                       capture_output=True, text=True, timeout=120, cwd=BASE, stdin=subprocess.DEVNULL)
    out = r.stdout.strip()
    if r.returncode != 0 or not out:
        raise RuntimeError((r.stderr or out).strip()[:200] or "empty output")
    return out.replace("—", ",").replace("–", "-")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("id", nargs="?")
    ap.add_argument("--text")
    ap.add_argument("--model", default="sonnet")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    tid = None
    text = a.text
    if not text:
        if not a.id:
            sys.exit("give an id prefix or --text")
        for line in open(os.path.join(BASE, "inbox.jsonl"), encoding="utf-8"):
            try:
                it = json.loads(line)
            except Exception:
                continue
            if it.get("id", "").startswith(a.id) and it.get("kind") != "page":
                tid, text = it["id"], it.get("text", "")
        if not text:
            sys.exit("no text thought with that id")
        if tid in load_state() and not a.dry_run:
            sys.exit("already replied to %s" % tid[:8])
    msg = reply(text, a.model)
    if a.dry_run:
        print(msg)
        return
    subprocess.run([os.path.expanduser("~/.local/bin/tg-send"), "text", "Jiga: " + msg], check=True)
    if tid:
        st = load_state()
        st[tid] = True
        os.makedirs(BASE, exist_ok=True)
        json.dump(st, open(STATE, "w"))
    print("sent")


if __name__ == "__main__":
    main()
